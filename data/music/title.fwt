$tBb $tBb $tF $tBb $tEb $tBb | c2/4 r/4 f2/4 r/4 |
enddef

part tuba ch 3 prog 58 vol 92
$tA $tF
$tA $tBb
$tEb $tEb $tBb $tBb | c2/4 r/4 g2/4 r/4 | g2/4 r/4 d2/4 r/4 | c2/4 r/4 g2/4 r/4 | f2/4 r/4 c2/4 r/4 |
$tA $tBb

define hBb
| r/4 d4+f4+bb4/4? r/4 d4+f4+bb4/4? |
enddef
define hF
| r/4 c4+eb4+a4/4? r/4 c4+eb4+a4/4? |
