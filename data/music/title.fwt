part horns ch 2 prog 61 vol 72
$hA $hF
$hA $hBb
$hEb $hEb $hBb $hBb | r/4 c4+eb4+g4/4? r/4 c4+eb4+g4/4? | r/4 b3+d4+f4/4? r/4 b3+d4+f4/4? |
| r/4 c4+e4+bb4/4? r/4 c4+e4+bb4/4? | r/4 c4+eb4+a4/4? r/4 c4+eb4+a4/4? |
$hA $hBb

define dBar
