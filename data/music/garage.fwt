| eb5/4. g5/8 c6/2 | a5/8 g5/8 f5/4 eb5/4 c5/4 | d5/2 f5/4 g5/4 | a5/2 r/2 |
enddef
define rest4
| r/1 | r/1 | r/1 | r/1 |
enddef
define rest8
$rest4 $rest4
enddef

