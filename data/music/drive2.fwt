# Country Mile: the second driving tune. A banjo's tune and a harmonica answering it over a boom-chick bass and
# guitar, a train beat on the snare; shuffled. 88 bars (about 2:56): a banjo roll in, the head in G (A A' B A'),
# the harmonica's chorus over the banjo's rolls, a fiddle break on the bridge, the banjo's last A, then up a
# tone to A for the bridge and the last A, and a tag on D7, which leads back round to G.
title Country Mile
tempo 120
meter 4/4
swing 0.7

define mA
| g4/8 b4/8 d5/8 b4/8 g5/4 d5/4 | e5/8 d5/8 b4/8 g4/8 a4/2 | c5/8 e5/8 g5/8 e5/8 c5/4 e5/4 |
| d5/8 b4/8 g4/8 b4/8 d5/2 | g4/8 b4/8 d5/8 b4/8 g5/4 b5/4 | a5/8 g5/8 f#5/8 e5/8 d5/4 c5/4 |
| b4/8 d5/8 g5/8 d5/8 b4/8 a4/8 g4/4 |
enddef
define mB
| c5/8 e5/8 g5/8 e5/8 c6/4 g5/4 | a5/8 g5/8 e5/8 c5/8 e5/2 | d5/8 g5/8 b5/8 g5/8 d5/4 b4/4 |
| g4/8 b4/8 d5/8 g5/8 b5/2 | c#5/8 e5/8 a5/8 e5/8 c#5/4 e5/4 | g5/8 f#5/8 e5/8 c#5/8 a4/2 |
| d5/8 f#5/8 a5/8 f#5/8 d5/4 c5/4 | b4/8 a4/8 f#4/8 a4/8 d5/2 |
enddef
# The same up a tone, in A.
define mA2
| a4/8 c#5/8 e5/8 c#5/8 a5/4 e5/4 | f#5/8 e5/8 c#5/8 a4/8 b4/2 | d5/8 f#5/8 a5/8 f#5/8 d5/4 f#5/4 |
| e5/8 c#5/8 a4/8 c#5/8 e5/2 | a4/8 c#5/8 e5/8 c#5/8 a5/4 c#6/4 | b5/8 a5/8 g#5/8 f#5/8 e5/4 d5/4 |
| c#5/8 e5/8 a5/8 e5/8 c#5/8 b4/8 a4/4 |
enddef
define mB2
| d5/8 f#5/8 a5/8 f#5/8 d6/4 a5/4 | b5/8 a5/8 f#5/8 d5/8 f#5/2 | e5/8 a5/8 c#6/8 a5/8 e5/4 c#5/4 |
| a4/8 c#5/8 e5/8 a5/8 c#6/2 | d#5/8 f#5/8 b5/8 f#5/8 d#5/4 f#5/4 | a5/8 g#5/8 f#5/8 d#5/8 b4/2 |
| e5/8 g#5/8 b5/8 g#5/8 e5/4 d5/4 | c#5/8 b4/8 g#4/8 b4/8 e5/2 |
enddef
# The banjo's rolls under another's tune.
define rG
| g4/8? b4/8? d5/8? b4/8? g4/8? b4/8? d5/8? b4/8? |
enddef
define rC
| g4/8? c5/8? e5/8? c5/8? g4/8? c5/8? e5/8? c5/8? |
enddef
define rD
| a4/8? d5/8? f#5/8? d5/8? a4/8? d5/8? f#5/8? d5/8? |
enddef
define rA7
| a4/8? c#5/8? e5/8? g5/8? a4/8? c#5/8? e5/8? g5/8? |
enddef
define rest8
| r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 |
enddef

part banjo ch 1 prog 105 vol 107
| g4/8 b4/8 d5/8 g5/8 b4/8 d5/8 g5/8 d5/8 | g4/8 b4/8 d5/8 g5/8 b4/8 d5/8 g5/8 b5/8 |
| a4/8 c5/8 d5/8 f#5/8 a4/8 c5/8 d5/8 f#5/8 | a5/8 f#5/8 d5/8 c5/8 a4/4 d4/4 |
$mA | a4/8 b4/8 c5/8 b4/8 a4/4 d4/4 |
$mA | g4/2 r/2 |
$mB
$mA | g4/2 r/2 |
$rG $rG $rC $rG $rG $rD $rG $rD
$rG $rG $rC $rG $rG $rD $rG $rG
$rC $rC $rG $rG $rA7 $rA7 $rD $rD
$mA | g4/2 r/2 |
$mB2
