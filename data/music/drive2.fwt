enddef
define cA7
| a2/4 c#4+e4+g4/4? e2/4 c#4+e4+g4/4? |
enddef
define cA
$cG $cG $cC $cG $cG $cD $cG
enddef
define cA2
| a2/4 c#4+e4+a4/4? e2/4 c#4+e4+a4/4? |
enddef
define cD2
| d3/4 d4+f#4+a4/4? a2/4 d4+f#4+a4/4? |
enddef
define cE
| e2/4 d4+e4+g#4/4? b2/4 d4+e4+g#4/4? |
enddef
define cB7
