part rhythm ch 3 prog 25 vol 81
$cG $cG $cD $cD
$cA $cD
$cA $cG
$cC $cC $cG $cG $cA7 $cA7 $cD $cD
$cA $cG
$cA $cD
$cA $cG
$cC $cC $cG $cG $cA7 $cA7 $cD $cD
$cA $cG
$cD2 $cD2 $cA2 $cA2 $cB7 $cB7 $cE $cE
$cA2 $cA2 $cD2 $cA2 $cA2 $cE $cA2 $cA2
$cA2 $cA2 $cD $cD

define dBar
| bd+sd/8? sd/8? sd/8? sd/8? bd+sd/8? sd/8? sd/8? sd/8? |
enddef
define dEnd
| bd+sd/8? sd/8? sd/8? sd/8? sd/8 sd/8 sd/8 cr/8 |
enddef
define dStrain
$dBar x7 $dEnd
enddef

part drums ch 10 prog 0 vol 105
$dBar x3 $dEnd
$dStrain $dStrain $dStrain $dStrain
$dStrain $dStrain
$dStrain $dStrain
$dStrain $dStrain
