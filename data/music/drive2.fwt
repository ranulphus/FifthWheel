| a4/8 c#5/8 e5/8 a5/8 c#5/8 e5/8 a5/8 e5/8 | a5/2 e5/4 c#5/4 | d5/8 f#5/8 a5/8 c6/8 a5/8 f#5/8 d5/4 |
| c6/8 a5/8 f#5/8 d5/8 c5/4 a4/4 |

define hA
| r/1 | r/2 b4/4. a4/8 | r/1 | r/2 d5/4. c5/8 | r/1 | r/2 c5/4 a4/4 | r/1 |
enddef
define hB
| e5/1 | c5/1 | d5/1 | b4/1 | c#5/1 | a4/1 | f#5/1 | d5/1 |
enddef
define hA2
| r/1 | r/2 c#5/4. b4/8 | r/1 | r/2 e5/4. d5/8 | r/1 | r/2 d5/4 b4/4 | r/1 |
enddef
define hB2
| f#5/1 | d5/1 | e5/1 | c#5/1 | d#5/1 | b4/1 | g#5/1 | e5/1 |
enddef

part harmonica ch 2 prog 22 vol 90
| r/1 | r/1 | r/1 | r/1 |
$hA | r/2 f#4/2 |
$hA | r/1 |
$hB
$hA | r/1 |
$mA | a4/8 b4/8 c5/8 b4/8 a4/4 d4/4 |
$mA | g4/2 r/2 |
$rest8
$hA | r/1 |
$hB2
$hA2 | r/1 |
| r/1 | r/2 e5/2 | r/1 | r/2 d5/2 |

# The fiddle's break on the bridge (C C G G A7 A7 D D).
part fiddle ch 4 prog 110 vol 98
| r/1 | r/1 | r/1 | r/1 |
$rest8 $rest8 $rest8 $rest8 $rest8 $rest8
| e5/8 g5/8 c6/8 g5/8 e5/8 g5/8 c6/4 | b5/8 a5/8 g5/8 e5/8 c5/2 | d5/8 g5/8 b5/8 d6/8 b5/8 g5/8 d5/4 |
| g5/8 f#5/8 e5/8 d5/8 b4/2 | c#5/8 e5/8 a5/8 c#6/8 a5/8 g5/8 e5/4 | g5/8 e5/8 c#5/8 a4/8 e5/2 |
| f#5/8 a5/8 d6/8 a5/8 f#5/8 a5/8 c6/4 | a5/8 f#5/8 d5/8 c5/8 a4/2 |
$rest8 $rest8 $rest8
| r/1 | r/1 | r/1 | r/1 |

define cG
| g2/4 b3+d4+g4/4? d2/4 b3+d4+g4/4? |
enddef
define cC
| c3/4 c4+e4+g4/4? g2/4 c4+e4+g4/4? |
enddef
define cD
